<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
Options -Indexes
Options +FollowSymLinks
RewriteEngine On



#RewriteCond %{HTTPS} off
#RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI}


#quitar extensión php
#RewriteCond %{REQUEST_FILENAME} !-d
#RewriteCond %{REQUEST_FILENAME}.php -f
#RewriteRule ^(.*)$ $1.php
#RewriteRule contact/(.*)/ contact.php [L]



#Add missing trailing slash
RewriteCond %{REQUEST_URI} /+[^\.]+$
RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]



#RewriteRule products/item/(.*)/ item.php?id=$1

#RewriteRule ^item/(.*)/(.*)/ item.php?id=$1/$2 [L]
RewriteRule ^item/(.*)/ item.php?id=$1 [L]


RewriteRule profile/(.*)/ profile.php?user=$1
RewriteRule products/item/(.*)/ item.php?id=$1
RewriteRule category/(.*)/ category.php?id=$1
RewriteRule subcat/(.*)/ sub-category.php?id=$1

#RewriteRule tags/(.*)/ tags.php
RewriteRule tags/(.*)$ tags.php?id=$1
RewriteRule color/(.*)$ color.php?id=$1
RewriteRule most-downloaded/$ most-downloaded.php [L]
RewriteRule ^recently-added/$ recently-added.php [L]
RewriteRule ^page/([^/]*)/(.*)$ custom-page.php?id=$1 [L]
#RewriteRule ^free(.*)$ free.php [L]

RewriteRule ^forum$ addons/forum/forum.php [L]
RewriteRule ^forum/category/([^/]*)-([^-]*)$ addons/forum/topics.php?cat=$2 [L]
RewriteRule ^forum/topic/([^/]*)-([^-]*)$ addons/forum/view.topic.php?id=$2 [L]
RewriteRule ^forum/check$ addons/forum/check.php [L]
RewriteRule ^forum/new-thread(.*)$ addons/forum/new.thread.php [L]
RewriteRule ^forum/search/threads(.*)$ addons/forum/search.php [L]
RewriteRule ^forum/search/sort(.*)$ addons/forum/sort.php [L]
RewriteRule ^forum/settings(.*)$ addons/forum/settings.php [L]
RewriteRule ^forum/rules(.*)$ addons/forum/rules.php [L]



#ErrorDocument 404 https://font.gooova.com/404.php

#redirecciona a una url con /
#RewriteCond %{REQUEST_URI} /+[^\.]+$
#RewriteRule ^(.*)/ %{REQUEST_URI}/ [R=301,L]

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php7_module>
   php_value error_reporting ~E_ALL
</IfModule>
<IfModule lsapi_module>
   php_value error_reporting ~E_ALL
</IfModule>
# END cPanel-generated php ini directives, do not edit







#descativar errores
php_flag display_startup_errors off
php_flag display_errors off
php_flag html_errors off
php_flag log_errors off
php_flag ignore_repeated_errors off
php_flag ignore_repeated_source off
php_flag report_memleaks off
php_flag track_errors off
php_value docref_root 0
php_value docref_ext 0

