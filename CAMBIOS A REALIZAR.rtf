-- 1. Migrar columna password a bcrypt\
ALTER TABLE logotic_users \
    MODIFY COLUMN `password` varchar(255) NOT NULL COMMENT 'bcrypt hash',\
    ADD COLUMN `ip_address` varchar(45) DEFAULT NULL AFTER `active`,\
    ADD COLUMN `last_login` datetime DEFAULT NULL AFTER `ip_address`,\
    ADD COLUMN `login_attempts` int(11) NOT NULL DEFAULT 0 AFTER `last_login`,\
    ADD COLUMN `locked_until` datetime DEFAULT NULL AFTER `login_attempts`,\
    ADD COLUMN `google_id` varchar(100) DEFAULT NULL AFTER `locked_until`,\
    ADD COLUMN `two_factor_enabled` tinyint(1) NOT NULL DEFAULT 0 AFTER `google_id`,\
    ADD COLUMN `password_hash` varchar(255) DEFAULT NULL AFTER `two_factor_enabled`;\
\
-- 2. Login attempts / rate limiting\
CREATE TABLE `logotic_login_attempts` (\
    `id` int(11) NOT NULL AUTO_INCREMENT,\
    `ip_address` varchar(45) NOT NULL,\
    `email` varchar(150) DEFAULT NULL,\
    `attempted_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\
    `success` tinyint(1) NOT NULL DEFAULT 0,\
    PRIMARY KEY (`id`),\
    KEY `ip_address` (`ip_address`),\
    KEY `attempted_at` (`attempted_at`)\
) ENGINE=InnoDB DEFAULT CHARSET=utf8;\
\
-- 3. Auditor\'eda\
CREATE TABLE `logotic_login_logs` (\
    `id` int(11) NOT NULL AUTO_INCREMENT,\
    `user_id` int(11) DEFAULT NULL,\
    `email` varchar(150) DEFAULT NULL,\
    `ip_address` varchar(45) NOT NULL,\
    `user_agent` varchar(500) DEFAULT NULL,\
    `action` enum('login','logout','failed','blocked','2fa_sent','2fa_verified','google') NOT NULL,\
    `details` varchar(255) DEFAULT NULL,\
    `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\
    PRIMARY KEY (`id`),\
    KEY `user_id` (`user_id`),\
    KEY `ip_address` (`ip_address`)\
) ENGINE=InnoDB DEFAULT CHARSET=utf8;\
\
-- 4. 2FA por email\
CREATE TABLE `logotic_2fa_codes` (\
    `id` int(11) NOT NULL AUTO_INCREMENT,\
    `user_id` int(11) NOT NULL,\
    `code` varchar(6) NOT NULL,\
    `expires_at` datetime NOT NULL,\
    `used` tinyint(1) NOT NULL DEFAULT 0,\
    `ip_address` varchar(45) DEFAULT NULL,\
    PRIMARY KEY (`id`),\
    KEY `user_id` (`user_id`),\
    KEY `expires_at` (`expires_at`)\
) ENGINE=InnoDB DEFAULT CHARSET=utf8;\
\
-- 5. Google OAuth\
CREATE TABLE `logotic_oauth` (\
    `id` int(11) NOT NULL AUTO_INCREMENT,\
    `user_id` int(11) NOT NULL,\
    `provider` varchar(20) NOT NULL DEFAULT 'google',\
    `provider_id` varchar(100) NOT NULL,\
    `email` varchar(150) NOT NULL,\
    `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\
    PRIMARY KEY (`id`),\
    UNIQUE KEY `provider_provider_id` (`provider`, `provider_id`)\
) ENGINE=InnoDB DEFAULT CHARSET=utf8;\
\
-- 6. CSRF tokens\
CREATE TABLE `logotic_csrf_tokens` (\
    `id` int(11) NOT NULL AUTO_INCREMENT,\
    `token` varchar(64) NOT NULL,\
    `session_id` varchar(64) NOT NULL,\
    `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\
    `expires_at` datetime NOT NULL,\
    PRIMARY KEY (`id`),\
    UNIQUE KEY `token` (`token`),\
    KEY `session_id` (`session_id`)\
) ENGINE=InnoDB DEFAULT CHARSET=utf8;\
\
-- 7. Migrar passwords MD5 existentes a bcrypt\
-- Esto marca los usuarios existentes para re-hashear en su pr\'f3ximo login\
UPDATE logotic_users SET password_hash = NULL WHERE password_hash IS NULL;\
